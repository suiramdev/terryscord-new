# Required
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Optional: when set, commands are re-synced for this guild and globally
DISCORD_GUILD_ID=

# Runtime
NODE_ENV=development
DISCORD_LOG_LEVEL=info
DISCORD_SYNC_COMMANDS_ON_BOOT=false

# Optional integrations
BOT_SERVER_RPC_URL=http://localhost:3000
BOT_RPC_HEALTHCHECK_ON_READY=false
BOT_DATABASE_HEALTHCHECK_ON_READY=false
BOT_DATABASE_URL=postgresql://postgres:password@localhost:5432/terryscord
BOT_DATABASE_PORT=5432
