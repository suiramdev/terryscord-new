model Guild {
  id        String   @id
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild")
}

model GuildVerificationSetting {
  guildId               String   @id
  verifiedRoleId        String?
  captchaCategoryId     String?
  attemptAlertChannelId String?
  captchaCaseSensitive Boolean?
  captchaNoiseLevel     Int?
  maxAttempts           Int?
  timeoutSeconds        Int?
  kickOnFailure         Boolean?
  allowAdminAccess      Boolean?
  channelNameFormat     String?
  captchaType           String?
  codeLength            Int?
  debugLogging          Boolean?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("guild_verification_setting")
}

model GuildVerificationSession {
  guildId               String
  userId                String
  verificationChannelId String
  challengeMessageId    String
  expectedResponse      String
  attemptsUsed          Int      @default(0)
  alertThresholdReached Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@id([guildId, userId])
  @@map("guild_verification_session")
}

model GuildRssSubscription {
  id                String    @id
  guildId           String
  channelId         String
  feedUrl           String
  messageStyleJson  String
  lastItemId        String?
  lastItemPublishedAt DateTime?
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([guildId, channelId, feedUrl], map: "guild_rss_subscription_unique")
  @@index([feedUrl], map: "guild_rss_subscription_feed_idx")
  @@map("guild_rss_subscription")
}

model GuildGiveaway {
  id                String   @id @default(cuid())
  guildId           String
  channelId         String
  messageId         String   @unique
  createdByUserId   String
  prize             String
  description       String?
  winnerCount       Int      @default(1)
  endsAt            DateTime
  requiredRoleIds   String[] @default([])
  ended             Boolean  @default(false)
  endedAt           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participants      GuildGiveawayParticipant[]

  @@index([guildId, ended], map: "guild_giveaway_guild_ended_idx")
  @@index([endsAt, ended], map: "guild_giveaway_ends_at_idx")
  @@map("guild_giveaway")
}

model GuildGiveawayParticipant {
  id          String   @id @default(cuid())
  giveawayId  String
  userId      String
  enteredAt   DateTime @default(now())

  giveaway    GuildGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId], map: "guild_giveaway_participant_unique")
  @@index([giveawayId], map: "guild_giveaway_participant_giveaway_idx")
  @@map("guild_giveaway_participant")
}

model GuildGiveawaySetting {
  guildId     String   @id
  pingRoleIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("guild_giveaway_setting")
}

model GuildChannelNameUpdater {
  id                    String   @id @default(cuid())
  guildId               String
  channelId             String
  nameTemplate          String
  updateIntervalMinutes Int      @default(10)
  enabled               Boolean  @default(false)
  lastUpdatedAt         DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("guild_channel_name_updater")
}
